@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# Configuration Vex was built with.
set(VEX_ENABLE_DX12 @VEX_ENABLE_DX12@)
set(VEX_ENABLE_VULKAN @VEX_ENABLE_VULKAN@)
set(VEX_ENABLE_SHADER_COMPILER @VEX_ENABLE_SHADER_COMPILER@)
set(VEX_ENABLE_DXC @VEX_ENABLE_DXC@)
set(VEX_ENABLE_SLANG @VEX_ENABLE_SLANG@)
set(VEX_USE_EMBEDDED_SHADERS @VEX_USE_EMBEDDED_SHADERS@)

# Shaders and sources deployed by vex_setup_runtime.
set(VEX_ROOT_DIR "${PACKAGE_PREFIX_DIR}/share/Vex")

# Vex's dependencies. magic_enum is installed alongside Vex, the others are found or downloaded the same way Vex's own
# build did it, by running the same scripts (see the "Dependencies" section of Vex's README).
find_dependency(magic_enum)
if(VEX_ENABLE_DX12)
    include("${CMAKE_CURRENT_LIST_DIR}/VexDX12.cmake")
endif()
if(VEX_ENABLE_VULKAN)
    find_dependency(Vulkan @VULKAN_MIN_VERSION@)
    # Otherwise SPIRV-Reflect was compiled into Vex.
    if(@VEX_SPIRV_REFLECT_FROM_PACKAGE@)
        find_dependency(unofficial-spirv-reflect)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/VexDXC.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/VexSlang.cmake")

include("${CMAKE_CURRENT_LIST_DIR}/VexTargets.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/VexHelpers.cmake")

check_required_components(Vex)

# To use an installed Vex in another project:
# find_package(Vex REQUIRED)
# ...
# # Later on once your target executable has been created:
# target_link_libraries(YourTarget PRIVATE Vex::Vex)
# vex_setup_runtime(YourTarget)
